---
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>David Arenas | Systems Architect</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<canvas id="canvas"></canvas>

		<main>
			<div class="terminal-window">
				<div class="terminal-header">
					<div class="dot red"></div>
					<div class="dot yellow"></div>
					<div class="dot green"></div>
				</div>
				<div id="typewriter"></div>
			</div>

			<div class="content-box">
				<h2 class="label">Strategic DNA • Software Engineering</h2>
				<h1 class="main-title">David Arenas</h1>
				<p class="description">
					Construyo <strong>arquitecturas full-stack</strong> personalizadas para transformar datos complejos en sistemas de control total.
				</p>
				
				<div class="buttons">
					<a href="https://eventanalytics.pro" class="btn-primary">Explorar UVEA</a>
					<a href="https://www.linkedin.com/in/davidarenasr1/" class="btn-secondary">Consultoría Directa</a>
				</div>
			</div>

			<footer class="footer">
				FastAPI • Astro • Supabase • Industrial Analytics
			</footer>
		</main>

		<script>
			// 1. ANIMACIÓN DE LA TERMINAL
			const lines = [
				"> Initializing connection...",
				"> Access granted: admin_arenas",
				"> Loading DNA_Model_v12...",
				"> Database: Supabase connected",
				"> Status: System Online",
				"> Ready for custom deployment_"
			];
			const container = document.getElementById('typewriter');
			let lineIndex = 0;

			function typeLine() {
				if (lineIndex < lines.length) {
					const p = document.createElement('p');
					p.style.margin = "5px 0";
					container.appendChild(p);
					let charIndex = 0;
					const currentLine = lines[lineIndex];
					
					const timer = setInterval(() => {
						p.textContent += currentLine[charIndex];
						charIndex++;
						if (charIndex === currentLine.length) {
							clearInterval(timer);
							lineIndex++;
							setTimeout(typeLine, 500);
						}
					}, 30);
				}
			}
			typeLine();

			// 2. TU LÓGICA DE PARTÍCULAS (Se mantiene igual)
			// ... (Agrega aquí tu código de canvas anterior)
		</script>
	</body>
</html>
